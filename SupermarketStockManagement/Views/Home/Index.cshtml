@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Supermarket Stock Management</h1>
    <p class="lead">Hệ thống quản lý kho siêu thị</p>
</div>

<div class="row mt-5">
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-primary h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Products</h5>
                <p class="card-text display-6" id="productCount">-</p>
                <a href="/api/Products" class="btn btn-light" target="_blank">API</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-success h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Categories</h5>
                <p class="card-text display-6" id="categoryCount">-</p>
                <a href="/api/Categories" class="btn btn-light" target="_blank">API</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-warning h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Stock</h5>
                <p class="card-text display-6" id="stockCount">-</p>
                <a href="/api/Stocks" class="btn btn-light" target="_blank">API</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-info h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Staff</h5>
                <p class="card-text display-6" id="staffCount">-</p>
                <a href="/api/Staffs" class="btn btn-light" target="_blank">API</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>API Endpoints</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Method</th>
                            <th>Endpoint</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>GET</td><td><a href="/api/Products" target="_blank">/api/Products</a></td><td>Danh sách sản phẩm</td></tr>
                        <tr><td>GET</td><td><a href="/api/Products/1" target="_blank">/api/Products/1</a></td><td>Chi tiết sản phẩm</td></tr>
                        <tr><td>GET</td><td><a href="/api/Categories" target="_blank">/api/Categories</a></td><td>Danh sách danh mục</td></tr>
                        <tr><td>GET</td><td><a href="/api/Stocks" target="_blank">/api/Stocks</a></td><td>Danh sách tồn kho</td></tr>
                        <tr><td>GET</td><td><a href="/api/Staffs" target="_blank">/api/Staffs</a></td><td>Danh sách nhân viên</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Fetch counts from API
        async function loadCounts() {
            try {
                const products = await fetch('/api/Products').then(r => r.json());
                document.getElementById('productCount').textContent = products.length;

                const categories = await fetch('/api/Categories').then(r => r.json());
                document.getElementById('categoryCount').textContent = categories.length;

                const stocks = await fetch('/api/Stocks').then(r => r.json());
                document.getElementById('stockCount').textContent = stocks.length;

                const staffs = await fetch('/api/Staffs').then(r => r.json());
                document.getElementById('staffCount').textContent = staffs.length;
            } catch (e) {
                console.log('API not ready yet');
            }
        }
        loadCounts();
    </script>
}
