@model IEnumerable<SupermarketStockManagement.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Product</a>
</p>

<!-- Search & Filter Form -->
<div class="card mb-4">
    <div class="card-header">
        <h5>Search & Filter</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="searchTerm" class="form-control"
                       value="@ViewBag.SearchTerm" placeholder="Search by name or description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Min Price</label>
                <input type="number" name="minPrice" class="form-control"
                       value="@ViewBag.MinPrice" step="0.01" placeholder="0" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Max Price</label>
                <input type="number" name="maxPrice" class="form-control"
                       value="@ViewBag.MaxPrice" step="0.01" placeholder="999" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
        <div class="row mt-2">
            <div class="col-md-12">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Filters</a>
            </div>
        </div>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                   asp-route-minPrice="@ViewBag.MinPrice"
                   asp-route-maxPrice="@ViewBag.MaxPrice"
                   asp-route-sortBy="name"
                   asp-route-sortOrder="@(ViewBag.SortBy == "name" && ViewBag.SortOrder == "asc" ? "desc" : "asc")">
                    @Html.DisplayNameFor(model => model.Name)
                    @if (ViewBag.SortBy == "name") { <text>@(ViewBag.SortOrder == "asc" ? "▲" : "▼")</text> }
                </a>
            </th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                   asp-route-minPrice="@ViewBag.MinPrice"
                   asp-route-maxPrice="@ViewBag.MaxPrice"
                   asp-route-sortBy="price"
                   asp-route-sortOrder="@(ViewBag.SortBy == "price" && ViewBag.SortOrder == "asc" ? "desc" : "asc")">
                    @Html.DisplayNameFor(model => model.Price)
                    @if (ViewBag.SortBy == "price") { <text>@(ViewBag.SortOrder == "asc" ? "▲" : "▼")</text> }
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                   asp-route-minPrice="@ViewBag.MinPrice"
                   asp-route-maxPrice="@ViewBag.MaxPrice"
                   asp-route-sortBy="category"
                   asp-route-sortOrder="@(ViewBag.SortBy == "category" && ViewBag.SortOrder == "asc" ? "desc" : "asc")">
                    Category
                    @if (ViewBag.SortBy == "category") { <text>@(ViewBag.SortOrder == "asc" ? "▲" : "▼")</text> }
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-searchTerm="@ViewBag.SearchTerm"
                   asp-route-categoryId="@ViewBag.SelectedCategoryId"
                   asp-route-minPrice="@ViewBag.MinPrice"
                   asp-route-maxPrice="@ViewBag.MaxPrice"
                   asp-route-sortBy="stock"
                   asp-route-sortOrder="@(ViewBag.SortBy == "stock" && ViewBag.SortOrder == "asc" ? "desc" : "asc")">
                    Stock
                    @if (ViewBag.SortBy == "stock") { <text>@(ViewBag.SortOrder == "asc" ? "▲" : "▼")</text> }
                </a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr>
            <td colspan="6" class="text-center text-muted">No products found.</td>
        </tr>
}
@foreach (var item in Model) {
        var isLowStock = item.Stock != null && item.Stock.Quantity <= item.Stock.LowStockThreshold;
        <tr class="@(isLowStock ? "table-warning" : "")">
            <td>
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" style="height: 30px; width: 30px; object-fit: cover; border-radius: 4px; margin-right: 8px;" />
                }
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>@Html.DisplayFor(model => item.Description)</td>
            <td>@item.Price.ToString("C")</td>
            <td>@item.Category?.Name</td>
            <td>
                @if (item.Stock != null)
                {
                    <span class="@(isLowStock ? "text-danger fw-bold" : "")">
                        @item.Stock.Quantity
                        @if (isLowStock)
                        {
                            <span class="badge bg-danger">Low Stock</span>
                        }
                    </span>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
