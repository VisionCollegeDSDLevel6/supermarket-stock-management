<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockFlow</title>

    <script>
            // Apply the saved theme before the page renders
            const savedTheme = localStorage.getItem("stockflow-theme");

            if (savedTheme) {
                document.documentElement.setAttribute(
                    "data-theme",
                    savedTheme
                );
            }
    </script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/SupermarketStockManagement.styles.css"
          asp-append-version="true" />
</head>

<body>
    <div class="app-layout">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="sidebar-brand">

                    <span class="brand-logo">
                        <svg viewBox="0 0 24 24"
                             width="25"
                             height="25"
                             fill="none">

                            <path d="M3 4H5L7.5 15H18.5L21 7H6"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />

                            <circle cx="9"
                                    cy="19"
                                    r="1.5"
                                    fill="currentColor" />

                            <circle cx="18"
                                    cy="19"
                                    r="1.5"
                                    fill="currentColor" />
                        </svg>
                    </span>

                    <span class="brand-text">
                        <strong>StockFlow</strong>
                        <small>Stock Management</small>
                    </span>
                </a>
            </div>

           <nav class="sidebar-navigation">

    <!-- Main Menu -->
    <p class="navigation-title">MAIN MENU</p>

    <a asp-controller="Home"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-icon">
            <svg viewBox="0 0 24 24"
                 width="20"
                 height="20"
                 fill="none">

                <rect x="3"
                      y="3"
                      width="7"
                      height="7"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="2" />

                <rect x="14"
                      y="3"
                      width="7"
                      height="7"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="2" />

                <rect x="3"
                      y="14"
                      width="7"
                      height="7"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="2" />

                <rect x="14"
                      y="14"
                      width="7"
                      height="7"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="2" />
            </svg>
        </span>

        <span>Dashboard</span>
    </a>


    <!-- Management -->
    <p class="navigation-title navigation-spacing">
        MANAGEMENT
    </p>

    <!-- Categories -->
    <a asp-controller="Categories"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-icon">
            <svg viewBox="0 0 24 24"
                 width="20"
                 height="20"
                 fill="none">

                <path d="M4 5H10V11H4V5Z"
                      stroke="currentColor"
                      stroke-width="2" />

                <path d="M14 5H20V11H14V5Z"
                      stroke="currentColor"
                      stroke-width="2" />

                <path d="M4 15H10V21H4V15Z"
                      stroke="currentColor"
                      stroke-width="2" />

                <path d="M14 15H20V21H14V15Z"
                      stroke="currentColor"
                      stroke-width="2" />
            </svg>
        </span>

        <span>Categories</span>
    </a>


    <!-- Products -->
    <a asp-controller="Products"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-icon">
            <svg viewBox="0 0 24 24"
                 width="20"
                 height="20"
                 fill="none">

                <path d="M4 7L12 3L20 7L12 11L4 7Z"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round" />

                <path d="M4 7V17L12 21L20 17V7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linejoin="round" />

                <path d="M12 11V21"
                      stroke="currentColor"
                      stroke-width="2" />
            </svg>
        </span>

        <span>Products</span>
    </a>


    <!-- Stock -->
    <a asp-controller="Stocks"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-icon">
            <svg viewBox="0 0 24 24"
                 width="20"
                 height="20"
                 fill="none">

                <path d="M4 20V10"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />

                <path d="M10 20V4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />

                <path d="M16 20V13"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />

                <path d="M22 20V7"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />
            </svg>
        </span>

        <span>Stock</span>
    </a>


    <!-- Staff -->
    <a asp-controller="Staffs"
       asp-action="Index"
       class="sidebar-link">

        <span class="sidebar-icon">
            <svg viewBox="0 0 24 24"
                 width="20"
                 height="20"
                 fill="none">

                <circle cx="12"
                        cy="8"
                        r="4"
                        stroke="currentColor"
                        stroke-width="2" />

                <path d="M4 21C4 16.6 7.6 13 12 13C16.4 13 20 16.6 20 21"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round" />
            </svg>
        </span>

        <span>Staff</span>
    </a>

</nav>

            <div class="sidebar-footer">
                <div class="system-status">
                    <span class="status-dot"></span>

                    <div>
                        <strong>System Online</strong>
                        <small>All services operational</small>
                    </div>
                </div>
            </div>
        </aside>


        <!-- Main area -->
        <div class="app-main">

            <!-- Top navigation -->
            <header class="topbar">

                <div class="topbar-left">

                    <button type="button"
                            class="icon-button mobile-menu-button"
                            id="sidebarToggle"
                            aria-label="Open menu">

                        <svg viewBox="0 0 24 24"
                             width="22"
                             height="22"
                             fill="none">

                            <path d="M4 7H20M4 12H20M4 17H20"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round" />
                        </svg>
                    </button>

                    <div class="topbar-search">
                        <svg viewBox="0 0 24 24"
                             width="19"
                             height="19"
                             fill="none">

                            <circle cx="11"
                                    cy="11"
                                    r="7"
                                    stroke="currentColor"
                                    stroke-width="2" />

                            <path d="M16 16L21 21"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round" />
                        </svg>

                        <input type="search"
                               placeholder="Search inventory..." />
                    </div>
                </div>

                <div class="topbar-actions">

                    <!-- Light/Dark mode switch -->
                    <button type="button"
                            class="theme-switch"
                            id="themeToggle"
                            aria-label="Switch theme">

                        <span class="theme-switch-icon sun-icon">
                            <svg viewBox="0 0 24 24"
                                 width="18"
                                 height="18"
                                 fill="none">

                                <circle cx="12"
                                        cy="12"
                                        r="4"
                                        stroke="currentColor"
                                        stroke-width="2" />

                                <path d="M12 2V4M12 20V22M4.93 4.93L6.34 6.34M17.66 17.66L19.07 19.07M2 12H4M20 12H22M4.93 19.07L6.34 17.66M17.66 6.34L19.07 4.93"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linecap="round" />
                            </svg>
                        </span>

                        <span class="theme-switch-track">
                            <span class="theme-switch-circle"></span>
                        </span>

                        <span class="theme-switch-icon moon-icon">
                            <svg viewBox="0 0 24 24"
                                 width="17"
                                 height="17"
                                 fill="none">

                                <path d="M21 15.5C19.6 16.2 18 16.5 16.5 16.2C12.3 15.5 9.5 11.5 10.2 7.3C10.5 5.7 11.2 4.3 12.3 3.2C7.5 3 3.4 6.4 2.6 11.2C1.8 16.3 5.3 21 10.4 21.8C14.8 22.5 19.1 19.8 21 15.5Z"
                                      stroke="currentColor"
                                      stroke-width="2"
                                      stroke-linejoin="round" />
                            </svg>
                        </span>
                    </button>

                    <div class="user-section">
                        <div class="user-avatar">SF</div>

                        <div class="user-information">
                            <strong>Administrator</strong>
                            <small>Stock Manager</small>
                        </div>
                    </div>
                </div>
            </header>


            <!-- Page content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="dashboard-footer">
                <span>© 2026 StockFlow</span>

                <span>
                    Supermarket Stock Management System
                </span>
            </footer>
        </div>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>