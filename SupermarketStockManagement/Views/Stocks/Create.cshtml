@model SupermarketStockManagement.Models.Stock

@{
    ViewData["Title"] = "Add Stock";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Add Stock</h1>
        <p class="page-subtitle">
            Create an inventory record for a product.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Stock
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card product-form-card">
            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Stock Information
                    </h2>

                    <p class="card-subtitle">
                        Select a product and enter its quantity.
                    </p>
                </div>

                <span class="required-note">* Required fields</span>
            </div>

            <form asp-action="Create" method="post">
                <div class="content-card-body">
                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="ProductId"
                                   class="form-label">
                                Product *
                            </label>

                            <select asp-for="ProductId"
                                    class="form-select"
                                    asp-items="ViewBag.ProductId">

                                <option value="">
                                    Select a product
                                </option>
                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>

                            <small class="form-help">
                                Products that already have Stock are excluded.
                            </small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Quantity"
                                   class="form-label">
                                Quantity *
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   min="0"
                                   placeholder="0" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LowStockThreshold"
                                   class="form-label">
                                Low-Stock Threshold *
                            </label>

                            <input asp-for="LowStockThreshold"
                                   class="form-control"
                                   min="0"
                                   placeholder="5" />

                            <span asp-validation-for="LowStockThreshold"
                                  class="text-danger">
                            </span>

                            <small class="form-help">
                                An alert appears at or below this quantity.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Create Stock Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}