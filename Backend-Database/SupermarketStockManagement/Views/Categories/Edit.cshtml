@model SupermarketStockManagement.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Category</h1>

        <p class="page-subtitle">
            Update information for @Model.Name.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Categories
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card product-form-card">

            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Category Information
                    </h2>

                    <p class="card-subtitle">
                        Category ID: @Model.CategoryId
                    </p>
                </div>

                <span class="category-badge">
                    Editing
                </span>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@Model.CategoryId"
                  method="post">

                <input type="hidden"
                       asp-for="CategoryId" />

                <div class="content-card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                Category Name *
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}