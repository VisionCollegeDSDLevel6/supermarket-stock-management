@model SupermarketStockManagement.Models.Category

@{
    ViewData["Title"] = "Add Category";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Add Category</h1>

        <p class="page-subtitle">
            Create a new group for supermarket products.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Categories
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card product-form-card">

            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Category Information
                    </h2>

                    <p class="card-subtitle">
                        Enter the category details below.
                    </p>
                </div>

                <span class="required-note">
                    * Required fields
                </span>
            </div>

            <form asp-action="Create" method="post">
                <div class="content-card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                Category Name *
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="For example: Drinks" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Enter a short category description...">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                            <small class="form-help">
                                Briefly describe the products in this category.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Create Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}