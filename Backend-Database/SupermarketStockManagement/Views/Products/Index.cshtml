@model IEnumerable<SupermarketStockManagement.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Products</h1>

        <p class="page-subtitle">
            Manage supermarket products, prices and inventory information.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Product
    </a>
</div>
<!-- Product Search and Category Filter -->
<div class="content-card mb-4">
    <div class="content-card-body">
        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- Search by product name -->
                <div class="col-md-6">
                    <label for="searchTerm"
                           class="form-label">
                        Search Product
                    </label>

                    <input type="search"
                           id="searchTerm"
                           name="searchTerm"
                           value="@ViewData["SearchTerm"]"
                           class="form-control"
                           placeholder="Enter product name..." />
                </div>

                <!-- Filter by category -->
                <div class="col-md-3">
                    <label for="categoryId"
                           class="form-label">
                        Category
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            class="form-select"
                            asp-items="ViewBag.CategoryId">

                        <option value="">
                            All Categories
                        </option>
                    </select>
                </div>

                <!-- Search buttons -->
                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary flex-fill">
                            Clear
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>
<!-- Products Table -->
<div class="content-card">

    <div class="content-card-header">
        <div>
            <h2 class="content-card-title">
                Product List
            </h2>

            <p class="card-subtitle">
                @Model.Count() products registered
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <!-- Product -->
                            <td>
                                <div class="product-cell">
                                    <div class="product-avatar">
                                        @item.Name.Substring(0, 1).ToUpper()
                                    </div>

                                    <div>
                                        <strong>@item.Name</strong>

                                        <small>
                                            Product ID: @item.ProductId
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <!-- Description -->
                            <td>
                                @if (string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <span class="text-muted">
                                        No description
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @item.Description
                                    </span>
                                }
                            </td>

                            <!-- Category -->
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="category-badge">
                                        @item.Category.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-status stock-empty">
                                        Not assigned
                                    </span>
                                }
                            </td>

                            <!-- Price -->
                            <td>
                                <strong class="product-price">
                                    @item.Price.ToString("C")
                                </strong>
                            </td>

                            <!-- Stock -->
                            <td>
                                @if (item.Stock == null)
                                {
                                    <span class="stock-status stock-empty">
                                        Not set
                                    </span>
                                }
                                else if (
                                    item.Stock.Quantity <=
                                    item.Stock.LowStockThreshold)
                                {
                                    <span class="stock-status stock-low">
                                        @item.Stock.Quantity units
                                    </span>
                                }
                                else
                                {
                                    <span class="stock-status stock-good">
                                        @item.Stock.Quantity units
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="action-button details-action"
                                       title="View details">
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.ProductId"
                                       class="action-button edit-action"
                                       title="Edit product">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.ProductId"
                                       class="action-button delete-action"
                                       title="Delete product">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="empty-products">

                            <div class="empty-products-icon">
                                <svg viewBox="0 0 24 24"
                                     width="32"
                                     height="32"
                                     fill="none">

                                    <path d="M4 7L12 3L20 7L12 11L4 7Z"
                                          stroke="currentColor"
                                          stroke-width="1.8" />

                                    <path d="M4 7V17L12 21L20 17V7"
                                          stroke="currentColor"
                                          stroke-width="1.8" />

                                    <path d="M12 11V21"
                                          stroke="currentColor"
                                          stroke-width="1.8" />
                                </svg>
                            </div>

                            <h3>No matching products found</h3>

                            <p>
                                Try changing the product name or category filter.
                            </p>

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Clear Filters
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>