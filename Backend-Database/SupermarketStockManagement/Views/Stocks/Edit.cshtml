@model SupermarketStockManagement.Models.Stock

@{
    ViewData["Title"] = "Edit Stock";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Stock</h1>
        <p class="page-subtitle">
            Update product quantity and warning threshold.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Stock
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card product-form-card">
            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Stock Information
                    </h2>

                    <p class="card-subtitle">
                        Stock ID: @Model.StockId
                    </p>
                </div>

                <span class="category-badge">Editing</span>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@Model.StockId"
                  method="post">

                <input type="hidden" asp-for="StockId" />

                <div class="content-card-body">
                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">
                        <div class="col-12">
                            <label asp-for="ProductId"
                                   class="form-label">
                                Product *
                            </label>

                            <select asp-for="ProductId"
                                    class="form-select"
                                    asp-items="ViewBag.ProductId">
                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Quantity"
                                   class="form-label">
                                Quantity *
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   min="0" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LowStockThreshold"
                                   class="form-label">
                                Low-Stock Threshold *
                            </label>

                            <input asp-for="LowStockThreshold"
                                   class="form-control"
                                   min="0" />

                            <span asp-validation-for="LowStockThreshold"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}