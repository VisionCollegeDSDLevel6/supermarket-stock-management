@model IEnumerable<SupermarketStockManagement.Models.Staff>

@{
    ViewData["Title"] = "Staff";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Staff</h1>

        <p class="page-subtitle">
            Manage supermarket staff members and their roles.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        + Add Staff
    </a>
</div>

<!-- Success message -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- Error message -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["ErrorMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="content-card">

    <div class="content-card-header">
        <div>
            <h2 class="content-card-title">
                Staff List
            </h2>

            <p class="card-subtitle">
                @Model.Count() staff members registered
            </p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">

            <thead>
                <tr>
                    <th>Staff Member</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Login Account</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var avatarLetter =
                            string.IsNullOrWhiteSpace(item.Name)
                                ? "?"
                                : item.Name
                                    .Substring(0, 1)
                                    .ToUpper();

                        var canManageItem =
                            User.IsInRole("Admin") ||
                            item.Role == "Staff";

                        <tr>
                            <td>
                                <div class="product-cell">

                                    <div class="staff-avatar">
                                        @avatarLetter
                                    </div>

                                    <div>
                                        <strong>@item.Name</strong>

                                        <small>
                                            Staff ID: @item.StaffId
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                <span class="role-badge">
                                    @item.Role
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(
                                    item.IdentityUserId))
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Login not created
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="table-actions">

                                    @if (canManageItem)
                                    {
                                        <a asp-action="Details"
                                           asp-route-id="@item.StaffId"
                                           class="action-button details-action">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.StaffId"
                                           class="action-button edit-action">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.StaffId"
                                           class="action-button delete-action">
                                            Delete
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Restricted
                                        </span>
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"
                            class="empty-products">

                            <div class="empty-products-icon">
                                👤
                            </div>

                            <h3>No staff members found</h3>

                            <p>
                                Add the first staff member to the system.
                            </p>

                            <a asp-action="Create"
                               class="btn btn-primary">
                                + Add First Staff Member
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>