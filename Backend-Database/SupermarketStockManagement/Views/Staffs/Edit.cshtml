@model SupermarketStockManagement.Models.Staff

@{
    ViewData["Title"] = "Edit Staff";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Staff</h1>
        <p class="page-subtitle">
            Update information for @Model.Name.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Back to Staff
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="content-card product-form-card">
            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Staff Information
                    </h2>

                    <p class="card-subtitle">
                        Staff ID: @Model.StaffId
                    </p>
                </div>

                <span class="category-badge">Editing</span>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@Model.StaffId"
                  method="post">

                <input type="hidden" asp-for="StaffId" />

                <div class="content-card-body">
                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">
                                Full Name *
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">
                                Email Address *
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Role" class="form-label">
                                Staff Role *
                            </label>

                            <select asp-for="Role" class="form-select">
                                <option value="Staff">Staff</option>
                                <option value="Manager">Manager</option>
                                <option value="Administrator">
                                    Administrator
                                </option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger">
                            </span>
                        </div>
                    </div>
                </div>

                <div class="form-footer">
                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}