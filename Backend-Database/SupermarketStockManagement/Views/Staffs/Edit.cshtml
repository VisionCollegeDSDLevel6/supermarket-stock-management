@model SupermarketStockManagement.ViewModels.StaffEditViewModel

@{
    ViewData["Title"] = "Edit Staff";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Staff</h1>

        <p class="page-subtitle">
            Update information for @Model.Name.
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        ← Back to Staff
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">

        <div class="content-card product-form-card">

            <div class="content-card-header">
                <div>
                    <h2 class="content-card-title">
                        Staff Information
                    </h2>

                    <p class="card-subtitle">
                        Staff ID: @Model.StaffId
                    </p>
                </div>

                <span class="category-badge">
                    Editing
                </span>
            </div>

            <form asp-action="Edit"
                  asp-route-id="@Model.StaffId"
                  method="post">

                <input type="hidden"
                       asp-for="StaffId" />

                <input type="hidden"
                       asp-for="IdentityUserId" />

                <div class="content-card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>

                    <div class="row g-4">

                        <!-- Full name -->
                        <div class="col-md-6">
                            <label asp-for="Name"
                                   class="form-label">
                                Full Name *
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter full name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email"
                                   class="form-label">
                                Email Address *
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="staff@example.com" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                This email is also used to log in.
                            </small>
                        </div>

                        <!-- Role -->
                        <div class="col-md-6">
                            <label asp-for="Role"
                                   class="form-label">
                                Staff Role *
                            </label>

                            <select asp-for="Role"
                                    class="form-select">

                                @if (User.IsInRole("Admin"))
                                {
                                    <option value="Manager">
                                        Manager
                                    </option>
                                }

                                <option value="Staff">
                                    Staff
                                </option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger">
                            </span>

                            @if (User.IsInRole("Manager"))
                            {
                                <small class="text-muted">
                                    Managers can only edit Staff accounts.
                                </small>
                            }
                        </div>

                        <div class="col-md-6"></div>

                        <!-- New password -->
                        <div class="col-md-6">
                            <label asp-for="NewPassword"
                                   class="form-label">
                                New Password
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   placeholder="Enter a new password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                            @if (string.IsNullOrWhiteSpace(
                                Model.IdentityUserId))
                            {
                                <small class="text-danger">
                                    Enter a password to create a login account
                                    for this existing staff member.
                                </small>
                            }
                            else
                            {
                                <small class="text-muted">
                                    Leave this field empty to keep the current
                                    password.
                                </small>
                            }
                        </div>

                        <!-- Confirm new password -->
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword"
                                   class="form-label">
                                Confirm New Password
                            </label>

                            <input asp-for="ConfirmNewPassword"
                                   class="form-control"
                                   placeholder="Enter the new password again" />

                            <span asp-validation-for="ConfirmNewPassword"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>
                </div>

                <div class="form-footer">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}